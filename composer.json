{
    "name": "saaspassport/core",
    "description": "Framework-agnostic PHP toolkit for SaaS data portability, migration, and verification.",
    "type": "library",
    "license": "Apache-2.0",
    "support": {
        "issues": "https://github.com/Mohamed-Salah199827/saas-passport/issues",
        "source": "https://github.com/Mohamed-Salah199827/saas-passport"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SaaSPassport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SaaSPassport\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "phpcs --standard=PSR12 src tests",
        "style:fix": "phpcbf --standard=PSR12 src tests",
        "verify": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@test",
            "@analyse",
            "@style"
        ]
    }
}
